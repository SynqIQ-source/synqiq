NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production origin for Supabase auth email links (invite,
# password reset). Must exactly match an entry in Supabase's Redirect URLs
# allow list -- request-derived origins (window.location.origin,
# x-forwarded-host) aren't reliable here since synqiq.co redirects to
# www.synqiq.co at the Vercel domain level, and www.synqiq.co isn't
# allow-listed. Leave unset in dev to fall back to the request origin.
NEXT_PUBLIC_SITE_URL=https://synqiq.co

MINDBODY_API_BASE_URL=https://api.mindbodyonline.com/public/v6
MINDBODY_API_KEY=
MINDBODY_SITE_ID=
MINDBODY_USERNAME=
MINDBODY_PASSWORD=

# Shared secret for /api/sync/* cron routes. Vercel sends this automatically
# as `Authorization: Bearer <value>` on cron-invoked requests once this is
# set in the project's env vars; manual calls must pass the same header.
CRON_SECRET=
